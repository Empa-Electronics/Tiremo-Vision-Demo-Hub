# Repository-wide ignores: operating system, editor and cache files.
# Project-specific rules (weights, datasets, results) belong in each application's own .gitignore.

# macOS
.DS_Store
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# Editors and IDEs
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Logs and temporary files
*.log
*.tmp
*.bak
